# Example environment variables
# For Oracle, set ORACLE_DSN or use a full SQLAlchemy URL in DATABASE_URL
DATABASE_URL=oracle+cx_oracle://user:password@host:port/?service_name=ORCLPDB1
# Alternatively for development/testing use sqlite:
# DATABASE_URL=sqlite:///./dev.db
SECRET_KEY=replace-this-with-a-secure-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
# For GitHub OAuth and AI providers keep keys here (do NOT commit real secrets)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
AI_PROVIDER_URL=
AI_PROVIDER_API_KEY=
